LOGIN_METHOD=pairing
PAIRING_PHONE=6281234567890

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq AI API (used by .curhat and .tanya commands)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.1-8b-instant

# Optional. Railway Volume users can leave this empty; the app uses
# RAILWAY_VOLUME_MOUNT_PATH automatically when a volume is attached.
# WWEBJS_DATA_PATH=/data

STICKER_PACKNAME=Made with love by DrxDvs
STICKER_AUTHOR=ENGINE V6 | DrxDvs
# local/Railway: QR tersedia sebagai link di log; pairing tetap opsional
LOGIN_METHOD=qr
# Isi pada Railway dengan domain publik service bila RAILWAY_PUBLIC_DOMAIN tidak tersedia.
# PUBLIC_URL=https://nama-service.up.railway.app
# Nomor internasional tanpa +/spasi, hanya wajib untuk LOGIN_METHOD=pairing
PAIRING_PHONE=
# Railway: arahkan ke mounted volume (mis. /data). Jangan pakai auth lokal.
WA_DATA_DIR=/data
# Override penuh bila diperlukan:
# WA_AUTH_PATH=
